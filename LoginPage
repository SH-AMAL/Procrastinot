import React, { useState } from 'react';
import { Mail, Lock, Eye, EyeOff } from 'lucide-react';

export default function LoginForm() {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [rememberMe, setRememberMe] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  const [showForgotPassword, setShowForgotPassword] = useState(false);
  const [resetEmail, setResetEmail] = useState('');

  const handleSubmit = (e: { preventDefault: () => void; }) => {
    e.preventDefault();
    console.log('Login:', { email, password, rememberMe });
  };

  const handleForgotPassword = (e: { preventDefault: () => void; }) => {
    e.preventDefault();
    console.log('Reset password for:', resetEmail);
    alert(`Password reset link sent to ${resetEmail}`);
    setShowForgotPassword(false);
    setResetEmail('');
  };

  if (showForgotPassword) {
    return (
      <div className="min-h-screen bg-gray-100 flex items-center justify-center p-4">
        <div className="bg-white rounded-3xl shadow-lg p-8 w-full max-w-md">
          <div className="flex justify-center mb-6">
            <img 
              src="/assets/images/Procrastinot.png" 
              alt="Logo" 
              className="w-40 h-40 rounded-2xl"
            />
          </div>
          
          <h1 className="text-3xl font-semibold text-indigo-900 text-center mb-8">Reset Password</h1>
          
          <form onSubmit={handleForgotPassword} className="space-y-6">
            <div className="relative">
              <Mail className="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-900 w-5 h-5" />
              <input
                type="email"
                placeholder="Email"
                value={resetEmail}
                onChange={(e) => setResetEmail(e.target.value)}
                className="w-full pl-12 pr-4 py-3 border-b-2 border-indigo-900 focus:outline-none focus:border-purple-600 text-gray-800"
                required
              />
            </div>

            <button
              type="submit"
              className="w-full bg-indigo-900 text-white py-3 rounded-lg font-semibold hover:bg-indigo-800 transition-colors"
            >
              SEND RESET LINK
            </button>

            <div className="text-center">
              <button
                type="button"
                onClick={() => setShowForgotPassword(false)}
                className="text-indigo-900 hover:text-purple-600 text-sm"
              >
                Back to Login
              </button>
            </div>
          </form>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-100 flex items-center justify-center p-4">
      <div className="bg-white rounded-3xl shadow-lg p-8 w-full max-w-md">
        <div className="flex justify-center mb-6">
          <div className="w-40 h-40 bg-gradient-to-br from-indigo-900 to-purple-900 rounded-2xl flex items-center justify-center">
            <svg className="w-32 h-32" viewBox="0 0 100 100" fill="none">
              <rect x="20" y="25" width="60" height="50" rx="4" fill="#7C3AED" stroke="white" strokeWidth="2"/>
              <line x1="20" y1="35" x2="80" y2="35" stroke="white" strokeWidth="2"/>
              <rect x="28" y="42" width="10" height="10" rx="2" fill="#A78BFA"/>
              <rect x="45" y="42" width="10" height="10" rx="2" fill="#A78BFA"/>
              <rect x="62" y="42" width="10" height="10" rx="2" fill="#A78BFA"/>
              <rect x="28" y="56" width="10" height="10" rx="2" fill="#A78BFA"/>
              <rect x="45" y="56" width="10" height="10" rx="2" fill="#A78BFA"/>
              <ellipse cx="75" cy="65" rx="12" ry="18" fill="#7C3AED" transform="rotate(-15 75 65)"/>
              <circle cx="75" cy="60" r="6" fill="#C4B5FD"/>
              <polygon points="75,70 70,80 80,80" fill="#F97316"/>
            </svg>
          </div>
        </div>
        
        <h1 className="text-3xl font-semibold text-indigo-900 text-center mb-8">Login</h1>
        
        <form onSubmit={handleSubmit} className="space-y-6">
          <div className="relative">
            <Mail className="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-900 w-5 h-5" />
            <input
              type="email"
              placeholder="Email"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="w-full pl-12 pr-4 py-3 border-b-2 border-indigo-900 focus:outline-none focus:border-purple-600 text-gray-800"
              required
            />
          </div>

          <div className="relative">
            <Lock className="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-900 w-5 h-5" />
            <input
              type={showPassword ? 'text' : 'password'}
              placeholder="Password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="w-full pl-12 pr-12 py-3 border-b-2 border-indigo-900 focus:outline-none focus:border-purple-600 text-gray-800"
              required
            />
            <button
              type="button"
              onClick={() => setShowPassword(!showPassword)}
              className="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-900"
            >
              {showPassword ? <EyeOff className="w-5 h-5" /> : <Eye className="w-5 h-5" />}
            </button>
          </div>

          <div className="flex items-center justify-between text-sm">
            <label className="flex items-center cursor-pointer">
              <input
                type="checkbox"
                checked={rememberMe}
                onChange={(e) => setRememberMe(e.target.checked)}
                className="w-4 h-4 border-2 border-indigo-900 rounded mr-2 accent-indigo-900"
              />
              <span className="text-gray-700">Remember Me</span>
            </label>
            <button
              type="button"
              onClick={() => setShowForgotPassword(true)}
              className="text-indigo-900 hover:text-purple-600"
            >
              Forgot password?
            </button>
          </div>

          <button
            type="submit"
            className="w-full bg-indigo-900 text-white py-3 rounded-lg font-semibold hover:bg-indigo-800 transition-colors"
          >
            SUBMIT
          </button>

          <div className="text-center text-sm text-gray-600">
            Don't have an account?{' '}
            <button
              type="button"
              onClick={() => console.log('Navigate to sign up')}
              className="text-indigo-900 hover:text-purple-600 font-semibold"
            >
              Sign Up
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
